# --- Firebase (Firestore) ---
# JSON da conta de serviço (Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada).
# Pode colar o JSON inteiro ou o JSON em base64:  base64 -i chave.json | tr -d '\n'
# Sem esta variável, o app roda em modo demonstração (dados em memória, não persistem).
FIREBASE_SERVICE_ACCOUNT=

# Para usar o emulador do Firestore em vez do Firebase de verdade (opcional):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=ecofrota-local

# --- App ---
# Motorista que usa o app neste protótipo (ainda não há login). O seed cria o Carlos com id "carlos".
DEFAULT_DRIVER_ID=carlos

# Protege o app inteiro com usuário e senha (recomendado na Vercel). Se vazio, o app fica aberto.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
